APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debug frontend: scrive file debug_*.log in storage/logs (vedi FrontendDebugLog).
EXTENDED_FAILSAFE_LOGGING=false
# Alias opzionale (stesso effetto se EXTENDED_FAILSAFE_LOGGING non è impostato):
# APP_EXTENDED_FAILSAFE_LOGGING=false
APP_URL=http://localhost

# Skin directory under resources/skins (empty = core default). See docs/ARCHITECTURE.md §3.
MERCATURA_SKIN=
# Checkout payment methods (bank_transfer completes without redirect; stripe and
# paypal use the gateways in config/mercatura.php payments.gateways)
MERCATURA_PAYMENT_METHODS=bank_transfer,stripe,paypal
# Supplier import connectors: private packages (docs/ARCHITECTURE.md §13); flags off in the core.
# One switch per installed package (MERCATURA_CONNECTOR_<KEY>=true); credentials
# are documented by each package (nereauweb/mercatura-connector-<key>).
# product_sizes row meaning "one size" (CoreSeeder creates it with this id)
MERCATURA_ONE_SIZE_ID=52

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# excel = tabelle statiche 2026 (live). json_v3 = feed API, convive in printing_variants.



# Ticketing interno
TICKET_API_URL=
TICKET_API_TOKEN=
TICKET_CUSTOMER_ID=

# Zendesk widget
ZENDESK_WIDGET_KEY=

# ---------------------------------------------------------------------------
# Providers (config/mercatura.php → app/Drivers). Switching one is a config
# change: set the name here and its credentials below.
# ---------------------------------------------------------------------------
# Search: any Scout engine. collection = plain DB, no service needed;
# algolia | meilisearch | typesense | database | null
MERCATURA_SEARCH_PROVIDER=collection
ALGOLIA_APP_ID=
ALGOLIA_SECRET=
ALGOLIA_SEARCH_KEY=
ALGOLIA_INDEX=products

# Captcha: recaptcha | null
MERCATURA_CAPTCHA_PROVIDER=recaptcha
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

# Transactional mail: brevo | mandrill (hosted templates) or a mailer name from
# config/mail.php (postmark, smtp, log, array…) rendering the mail.* Blade views.
# "default" uses MAIL_MAILER.
MAIL_PROVIDER=default
POSTMARK_TOKEN=
BREVO_API_KEY=
# Brevo hosted template ids (only with MAIL_PROVIDER=brevo)
BREVO_TPL_CONTACT_ADMIN=
BREVO_TPL_WELCOME=
BREVO_TPL_PASSWORD_RESET=
BREVO_TPL_QUOTATION_CUSTOMER=
BREVO_TPL_QUOTATION_ADMIN=
BREVO_TPL_REGISTER_ADMIN=
BREVO_TPL_ORDER_STORED_USER=
BREVO_TPL_ORDER_STORED_ADMIN=
BREVO_TPL_ORDER_PAID_USER=
BREVO_TPL_ORDER_PAID_ADMIN=
BREVO_TPL_ORDER_UPDATED=
BREVO_TPL_ORDER_SENT=
BREVO_TPL_ORDER_CANCELLED=
# Mandrill (Mailchimp Transactional): MAIL_PROVIDER=mandrill
MANDRILL_API_KEY=
MANDRILL_FROM_EMAIL=
MANDRILL_FROM_NAME=
MANDRILL_TPL_CONTACT_ADMIN=
MANDRILL_TPL_WELCOME=
MANDRILL_TPL_PASSWORD_RESET=
MANDRILL_TPL_QUOTATION_CUSTOMER=
MANDRILL_TPL_QUOTATION_ADMIN=
MANDRILL_TPL_REGISTER_ADMIN=
MANDRILL_TPL_ORDER_STORED_USER=
MANDRILL_TPL_ORDER_STORED_ADMIN=
MANDRILL_TPL_ORDER_PAID_USER=
MANDRILL_TPL_ORDER_PAID_ADMIN=
MANDRILL_TPL_ORDER_UPDATED=
MANDRILL_TPL_ORDER_SENT=
MANDRILL_TPL_ORDER_CANCELLED=

# Newsletter: brevo | mailchimp | null
NEWSLETTER_PROVIDER=null
BREVO_NEWSLETTER_LIST_ID=
# Brevo contact attribute names of the account (defaults: FIRSTNAME, LASTNAME, SMS, TYPE, COMPANY, ACTIVITY)
BREVO_ATTR_NAME=
BREVO_ATTR_SURNAME=
BREVO_ATTR_PHONE=
BREVO_ATTR_TYPE=
BREVO_ATTR_COMPANY=
BREVO_ATTR_ACTIVITY=
# Mailchimp Marketing: NEWSLETTER_PROVIDER=mailchimp (create the audience and merge fields first)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_MERGE_NAME=FNAME
MAILCHIMP_MERGE_SURNAME=LNAME
MAILCHIMP_MERGE_PHONE=PHONE
MAILCHIMP_MERGE_TYPE=TIPO
MAILCHIMP_MERGE_COMPANY=COMPANY
MAILCHIMP_MERGE_ACTIVITY=ACTIVITY

# AI enrichment and personalization: null only in v2a
MERCATURA_AI_PROVIDER=null
MERCATURA_PERSONALIZATION_PROVIDER=null
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
