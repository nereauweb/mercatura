{
    "name": "nereauweb/mercatura",
    "type": "project",
    "description": "Neutral B2B/B2C e-commerce core on Laravel.",
    "keywords": ["framework", "laravel"],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.4",
        "algolia/algoliasearch-client-php": "~3.3.2",
        "enshrined/svg-sanitize": "^0.22.0",
        "filament/filament": "^5.8",
        "filament/spatie-laravel-media-library-plugin": "^5.8",
        "getbrevo/brevo-php": "^2.0",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^2.7",
        "juanparati/brevosuite": "^13.0",
        "larastan/larastan": "^3.0",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^11.0",
        "laravel/tinker": "^2.8|^3.0",
        "maatwebsite/excel": "^4.0",
        "mailchimp/marketing": "^3.0",
        "mailchimp/transactional": "^1.4",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "saloonphp/xml-wrangler": "^1.2",
        "spatie/browsershot": "^5.0",
        "spatie/laravel-cookie-consent": "^3.5",
        "spatie/laravel-ignition": "^2.10",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-pdf": "^2.0",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-sitemap": "^8.0",
        "srmklive/paypal": "^3.1",
        "symfony/postmark-mailer": "^7.4",
        "timehunter/laravel-google-recaptcha-v3": "~2.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pint": "pint",
        "larastan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
