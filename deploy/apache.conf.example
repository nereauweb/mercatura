# Mercatura — Apache 2.4 virtual host (Debian: /etc/apache2/sites-available/mercatura.conf)
# Modules: a2enmod rewrite headers expires proxy_fcgi setenvif ssl http2 ; a2enconf php8.4-fpm
# PHP through php8.4-fpm (mpm_event), not mod_php. Replace example.com and the paths.

<VirtualHost *:80>
    ServerName example.com
    RewriteEngine On
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName example.com
    DocumentRoot /var/www/mercatura/public
    Protocols h2 http/1.1

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/example.com/privkey.pem

    <Directory /var/www/mercatura/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # PHP-FPM; the long timeout is for admin uploads, not for imports (those run on the queue worker).
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost"
    </FilesMatch>
    ProxyTimeout 120

    # Artwork uploads are up to 20 MB (App\Support\ArtworkFiles); keep php.ini upload_max_filesize / post_max_size at 32M.
    LimitRequestBody 41943040

    # Hashed build assets and skin assets: long cache. robots.txt is answered by the application (MERCATURA_STAGING).
    <LocationMatch "^/(build|skins|css|js|fonts)/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </LocationMatch>
    <LocationMatch "^/storage/">
        Header set Cache-Control "public, max-age=2592000"
    </LocationMatch>

    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml

    ErrorLog  ${APACHE_LOG_DIR}/mercatura-error.log
    CustomLog ${APACHE_LOG_DIR}/mercatura-access.log combined
</VirtualHost>
